# Copy this file to .env.local for local development.
# In production (Vercel), set these under Project > Settings > Environment Variables.

# ---- Groq (LLM) ----
# Create a free key at https://console.groq.com/keys
GROQ_API_KEY=

# Model used by the AI agent. Change this alone to swap models later —
# nothing else in the code needs to change.
AI_MODEL=openai/gpt-oss-20b

# ---- Supabase ----
# Project Settings > API in your Supabase dashboard.
# IMPORTANT: SUPABASE_SERVICE_ROLE_KEY is a secret with full database
# access. It must NEVER be prefixed with NEXT_PUBLIC_ and must never be
# used in any client component — only in server-only files under
# src/lib/supabase and src/lib/ai.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Security (optional) ----
# Shared secret required to call /api/ai/health in production (it runs a
# live Groq + Supabase diagnostic and is not meant for public access).
# Generate one with `openssl rand -hex 32` and pass it back as either the
# "x-health-secret" header or a "?secret=" query param when checking.
# Not required in local development.
HEALTH_CHECK_SECRET=

# Public URL of this deployment (e.g. https://della.com.br), used to scope
# CORS on the API routes to this site only. Leave unset in local dev.
SITE_URL=
